generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// AttendMate Pro — accounts and attendance data.
// SQLite single-file DB; see README "Production" for backup & hardening notes.

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  rollNo         Int      @default(1)
  theoryTarget   Int      @default(75)
  clinicalTarget Int      @default(80)
  theme          String   @default("light")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs      AttendanceLog[]
  baselines Baseline[]
  modules   ModuleDone[]

  @@index([email])
}

/// One row per logged timetable slot: unique (user, date, slotId).
model AttendanceLog {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  slotId    String
  status    String // present | absent | cancelled
  subject   String? // credited subject code, "CP" = roster-resolved posting
  kind      String? // theory | clinical
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, slotId])
  @@index([userId, date])
}

/// Prior-record baseline per subject code, merged with live logs client-side.
model Baseline {
  id              String   @id @default(cuid())
  userId          String
  code            String
  theoryPresent   Int      @default(0)
  theoryTotal     Int      @default(0)
  clinicalPresent Int      @default(0)
  clinicalTotal   Int      @default(0)
  updatedAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

/// Module completion markers; row presence = done. Key: "aetcom:4.1" | "pandemic:P4.1".
model ModuleDone {
  id        String   @id @default(cuid())
  userId    String
  moduleKey String
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
}
